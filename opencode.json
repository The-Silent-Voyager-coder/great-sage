{
  "$schema": "https://opencode.ai/config.json",
  // Great Sage project config — portable, zero-cost, local-first.
  // Merges with the global config (~/.config/opencode/opencode.jsonc),
  // which already wires the full ECC library (plugin + 35 OpenCode
  // commands + 271 skills via ~/.opencode). This file adds ONLY
  // Great Sage bindings: server endpoint matching
  // config/sage.example.yaml (ai.providers.opencode), Great Sage
  // instruction docs so the executor respects Great Sage authority, and
  // restrictive permissions so every write/exec surfaces as a
  // permission request for the Great Sage SecurityPolicy to decide.
  // No user-specific absolute paths (see docs/DEVELOPMENT_RULES.md §1 anti-pattern 6).
  // Model default is a free-tier Zen model (zero-cost rule holds):
  // paid-model defaults are never set here.
  "server": {
    "port": 4096,
    "hostname": "127.0.0.1"
  },
  "instructions": [
    "docs/ARCHITECTURE.md",
    "docs/DEVELOPMENT_RULES.md",
    "docs/SECURITY_MODEL.md",
    "docs/TOOLS.md",
    "docs/AGENTS.md",
    "docs/OPENCODE_INTEGRATION.md",
    "docs/INTERFACES.md",
    "docs/CONFIGURATION.md",
    "docs/TESTING.md"
  ],
  // Great Sage is authority, OpenCode is executor: anything that mutates
  // state or reaches the network must surface as `ask` so the
  // DelegationManager can ALLOW/ASK/DENY per the security pipeline.
  // `read` stays at the OpenCode default (allow) — SAFE reads inside
  // allowed roots are auto-approved by Great Sage policy anyway.
  // Never set blanket allow / --auto for unrestricted bash+edit.
  // Default model for everything the server runs by itself (delegation
  // sessions, bare prompts): Muse Spark 1.3 at xhigh effort for smart
  // work. Lighter callers pass an explicit variant instead
  // (e.g. "...#medium" for normal talk). Variants are server-side effort
  // presets: unknown names fail loudly, never silently downgrade.
  "model": "opencode/muse-spark-1.3-contributor-free#xhigh",
  "permission": {
    "edit": "ask",
    "bash": "ask",
    "task": "ask",
    "skill": "ask",
    "question": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": "ask"
  }
}
