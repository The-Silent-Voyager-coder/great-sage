# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
# Secrets are injected as environment variables — they are NEVER stored in
# config files or source code. See docs/CONFIGURATION.md.

# Optional: API keys for future external providers (all optional, zero-cost core)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_API_KEY=

# Optional: OpenCode server (v2 API) endpoint + auth
# OPENCODE_BASE_URL=http://127.0.0.1:4096
# Server password: printed by `opencode serve` on launch, or set your own
# with OPENCODE_SERVER_PASSWORD before starting the server. The value below
# is the server password (HTTP Basic auth), never committed.
# OPENCODE_API_KEY=
# Optional: server username override (server default is "opencode").
# OPENCODE_API_USER=
